+/* ---------- NT36523 SPI framing ---------- */
 static int
+nvt_write(const uint8_t *buf, size_t len)
+{
+	uint8_t rx[8].
+	if (len > sizeof(rx))
+		return -1.
+	return touch_spi_xfer(buf, rx, len).
+}
+
+/* Select the 32 KiB page holding addr: 0xff, addr[22:15], addr[14:7]. */
+static int
+nvt_set_page(uint32_t addr)
+{
+	uint8_t b[3] = { 0xff, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) }.
+	return nvt_write(b, sizeof(b)).
+}
+
+/* Write: address byte (bit 7 set), then data. */
+static int
+nvt_write_addr(uint32_t addr, uint8_t val)
+{
+	uint8_t b[2] = { NVT_SPI_WRITE(addr), val }.
+	if (nvt_set_page(addr))
+		return -1.
+	return nvt_write(b, sizeof(b)).
+}
+
+/* Read: address byte (bit 7 clear), one dummy byte, then data. */
+static int
+nvt_read(uint32_t addr, uint8_t *out, size_t len)
+{
+	uint8_t tx[NVT_XFER_MAX] = { 0 }.
+	uint8_t rx[NVT_XFER_MAX].
+
+	if (len > NVT_XFER_MAX - NVT_SPI_HDR || nvt_set_page(addr))
+		return -1.
+	tx[0] = NVT_SPI_READ(addr).
+	if (touch_spi_xfer(tx, rx, NVT_SPI_HDR + len))
+		return -1.
+	for (size_t i = 0; i < len; ++i)
+		out[i] = rx[NVT_SPI_HDR + i].
+	return 0.
+}
